{
  "expo": {
    "name": "Hafsa Shastho",
    "slug": "hafsa-shastho",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
   "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hafsahealth.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "হাফসা আপার সাথে কথা বলতে স্পিচ রিকগনিশন দরকার",
        "NSMicrophoneUsageDescription": "হাফসা আপার সাথে কথা বলতে মাইক্রোফোন দরকার"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.hafsahealth.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
   "plugins": [
      "expo-font",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "হাফসা আপার সাথে কথা বলতে মাইক্রোফোন দরকার",
          "speechRecognitionPermission": "আপনার কথা বুঝতে স্পিচ রিকগনিশন দরকার"
        }
      ]
    ],
